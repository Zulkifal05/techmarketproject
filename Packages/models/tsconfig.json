{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2020",

    "declaration": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}